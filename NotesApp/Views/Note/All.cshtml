@model List<NotesApp.Models.Note>

@{
    ViewData["Title"] = "Все заметки";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-list"></i> Все заметки</h1>
    <div>
        <a href="@Url.Action("Add")" class="btn btn-success">
            <i class="fas fa-plus"></i> Создать заметку
        </a>
        <a href="@Url.Action("Export", new { n = ViewData["N"], sort = ViewData["Sort"] })" class="btn btn-secondary">
            <i class="fas fa-download"></i> Экспорт (JSON)
        </a>
    </div>
</div>

<!-- Форма фильтрации вывода -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-sliders-h"></i> Параметры отображения
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label>Максимум записей (0 = все)</label>
                <input type="number" name="n" class="form-control" value="@ViewData["N"]" min="0" />
            </div>
            <div class="col-md-4">
                <label>Сортировка</label>
                <select name="sort" class="form-control">
                    <option value="">По ID</option>
                    <option value="Title" selected="@(ViewData["Sort"]?.ToString() == "Title")">По заголовку (А-Я)</option>
                    <option value="TitleDesc" selected="@(ViewData["Sort"]?.ToString() == "TitleDesc")">По заголовку (Я-А)</option>
                    <option value="Date" selected="@(ViewData["Sort"]?.ToString() == "Date")">По дате (старые первые)</option>
                    <option value="DateDesc" selected="@(ViewData["Sort"]?.ToString() == "DateDesc")">По дате (новые первые)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-sync"></i> Применить
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Нет заметок. 
        <a href="@Url.Action("Add")">Создайте первую заметку</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var note in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            @note.Title
                            @if (note.Date.Date == DateTime.Now.Date)
                            {
                                <span class="badge bg-success">Новая</span>
                            }
                        </h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            <i class="far fa-calendar-alt"></i> @note.Date.ToString("dd.MM.yyyy HH:mm")
                        </h6>
                        <p class="card-text">@(note.Description.Length > 100 ? note.Description.Substring(0, 100) + "..." : note.Description)</p>
                        
                        @if (note.Categories.Any())
                        {
                            <div class="mb-2">
                                @foreach (var cat in note.Categories)
                                {
                                    <span class="badge bg-info text-dark">@cat.Title</span>
                                }
                            </div>
                        }
                        
                        <div class="mt-3">
                            <a href="@Url.Action("Details", new { id = note.Id })" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = note.Id })" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Remove" asp-route-id="@note.Id" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить заметку?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="mt-3 text-muted">
        Показано: @Model.Count из @ViewData["N"] (0 = все)
    </div>
}

<a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary mt-3">
    <i class="fas fa-home"></i> На главную
</a>