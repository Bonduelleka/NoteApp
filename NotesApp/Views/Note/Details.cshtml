@model NotesApp.Models.Note

@{
    ViewData["Title"] = "Детали заметки";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h3><i class="fas fa-info-circle"></i> @Model.Title</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.Id</dd>
                    
                    <dt class="col-sm-3">Заголовок</dt>
                    <dd class="col-sm-9">@Model.Title</dd>
                    
                    <dt class="col-sm-3">Описание</dt>
                    <dd class="col-sm-9">@Html.Raw(Model.Description.Replace("\n", "<br/>"))</dd>
                    
                    <dt class="col-sm-3">Дата создания</dt>
                    <dd class="col-sm-9">@Model.Date.ToString("dd.MM.yyyy HH:mm:ss")</dd>
                    
                    <dt class="col-sm-3">Категории</dt>
                    <dd class="col-sm-9">
                        @if (Model.Categories.Any())
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <span class="badge bg-secondary">@cat.Title</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Нет категорий</span>
                        }
                    </dd>
                </dl>
                
                <div class="mt-3">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Редактировать
                    </a>
                    <a href="@Url.Action("All")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Назад к списку
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>