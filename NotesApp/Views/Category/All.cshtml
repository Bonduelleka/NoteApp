@model IEnumerable<NotesApp.Models.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-tags"></i> Категории</h1>
    <a href="@Url.Action("Add")" class="btn btn-success">
        <i class="fas fa-plus"></i> Добавить категорию
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> Нет категорий. 
        <a href="@Url.Action("Add")">Создайте первую категорию</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@category.Title</h5>
                        <p class="card-text">@(category.Description ?? "Нет описания")</p>
                        <p class="text-muted small">Заметок: @category.Notes.Count</p>
                        
                        <div class="mt-2">
                            <a href="@Url.Action("Details", new { id = category.Id })" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = category.Id })" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Remove" asp-route-id="@category.Id" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить категорию? Заметки останутся без категории')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}