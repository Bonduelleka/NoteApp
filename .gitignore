# Visual Studio / .NET Core standard ignores

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
*.dotSettings

# Visual Studio Code
.vscode/

# Rider
.idea/

# NuGet Package restore
packages/
*.nupkg
*.snupkg
!packages/repositories.config

# ASP.NET Core
wwwroot/lib/
wwwroot/dist/
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/appsettings.Staging.json

# Entity Framework Migrations
**/Migrations/*.Designer.cs
**/Migrations/*.cs
!**/Migrations/DesignTimeDbContextFactory.cs

# Database files
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3
*.bak
*.log

# PostgreSQL dumps
*.backup
*.sql

# User secrets
secrets.json

# Logs
logs/
*.log
*.txt

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# ==========================
# .NET / C# specific
# ==========================

# Compiled source
*.pdb
*.dll
*.exe
*.so
*.dylib

# Backup files
*~

# JetBrains Rider
*.sln.iml

# Test results
TestResults/
*.trx

# Code coverage
*.coverage
*.coveragexml

# Publish profiles
*.pubxml
*.pubxml.user

# Node modules (if you use npm in frontend)
node_modules/
npm-debug.log
yarn-error.log

# Docker
docker-compose.override.yml
